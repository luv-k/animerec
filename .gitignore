data/
*.mp4
*.mov
*.avi
*.mkv

web


# ==========================================
# Backend Specific Overrides (backend/)
# ==========================================
backend/venv/
backend/__pycache__/
backend/*.pyc
backend/data/
backend/media/*.mp4
backend/.env

# ==========================================
# Frontend Specific Overrides (animerec/)
